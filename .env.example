# Resend API key (https://resend.com/api-keys). Without it, dev logs messages instead of sending.
RESEND_API_KEY=
# Optional: where messages go (defaults to the email in src/content/profile.ts)
CONTACT_TO_EMAIL=
# Optional: sender. onboarding@resend.dev only delivers to your own Resend account email;
# verify a domain in Resend to use e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
